<launch>
    <node pkg="marlin_ros" exec="marlin_node"/>

    <node pkg="arducam_ros" exec="tof_pointcloud">
      <param name="rotation_angle" value="-90.0" />
    </node>

    <node pkg="rock_detector" exec="rock_detector_node">
        <param name="k_neighbors" value="40" />
        <param name="min_cluster_size" value="25" /> 
        <param name="max_cluster_size" value="3000" /> 
        <param name="plane_threshold" value="0.01" />
        <param name="cluster_tolerance" value="0.003" />
        
    </node>

    <node pkg="delta_ros" exec="rock_stacking" name="rock_stacking" output="screen">
    </node>
</launch>